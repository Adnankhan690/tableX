meta {
  name: change-password
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/admin/v1/auth/change-password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "current_password": "{{staff_password}}",
    "new_password": "password123"
  }
}

tests {
  test("responds 200", function () {
    expect(res.status).to.equal(200)
  })

  test("envelope reports success", function () {
    // Asserting on `code`, not `message`: codes are stable, messages are human copy that will be
    // translated (PRD section 7).
    expect(res.body.code).to.equal("00000")
  })
}

docs {
  # Change your own password

The current password is required even though the caller is already authenticated: that is what stops
a walked-away-from tablet being used to lock the real owner out of their own account.

Set as a no-op here (new == current) so a full collection run does not invalidate
`staff_password`.
}
