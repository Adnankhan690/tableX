meta {
  name: create-staff
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/admin/v1/staff
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "Kavya Iyer",
    "email": "kavya@spicegarden.test",
    "password": "password123",
    "role": "staff"
  }
}

script:post-response {
  if (res.status === 201 && res.body.data) {
    bru.setVar("new_staff_uid", res.body.data.uid)
  }
}

tests {
  test("responds 201, or 409 if the email is taken", function () {
    expect([201, 409]).to.include(res.status)
  })
}

docs {
  # Create a staff login

**Owner only** -- sign in as `{{staff_email_floor}}` and this answers `TX_AUT_006` (403).

Email is unique per restaurant, not globally, because the same person may staff two unrelated
restaurants on the platform.
}
