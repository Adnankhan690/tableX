{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "allowJs": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@tablex/shared": ["../../packages/shared/src/index.ts"],
      "@tablex/shared/*": ["../../packages/shared/src/*"],
      "@tablex/api-client": ["../../packages/api-client/src/index.ts"],
      "@tablex/api-client/*": ["../../packages/api-client/src/*"],
      "@tablex/ui": ["../../packages/ui/src/index.ts"],
      "@tablex/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["../../types/css.d.ts", "next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
