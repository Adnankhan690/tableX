# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
out/
backend/bin/
*.tsbuildinfo

# Go
backend/coverage.out
backend/coverage.html
*.test
vendor/

# Environment -- never commit real secrets. .env.example is the checked-in template.
.env
.env.local
.env.*.local
!.env.example
backend/config/*.local.yml
backend/config/staging.yml
# production.yml is deliberately NOT ignored. It carries the production *shape* -- pool
# sizes, timeouts, ssl_mode, log format -- and no secrets: jwt_secret, admin_token and the
# database credentials all come from the environment (see the header of that file). The
# Docker image COPYs it, so ignoring it makes every build that clones this repo fail on a
# missing file while building fine on a machine that happens to have it locally.

# Test artifacts
playwright-report/
test-results/
blob-report/
.playwright/

