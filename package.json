{
  "name": "tablex",
  "version": "0.1.0",
  "private": true,
  "description": "Restaurant QR table ordering platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:diner": "bun run --cwd apps/diner dev",
    "dev:admin": "bun run --cwd apps/admin dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^25.7.0",
    "@usebruno/cli": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=20"
  }
}
