# tableX -- local environment template. Copy to .env and fill in.
# Every value here is also settable in backend/config/local.yml; the environment wins.

# --- Application ---
TABLEX_ENV=local
# The origin encoded into every table QR code. Getting this wrong prints a floor's worth
# of stickers pointing at the wrong host, so it is validated at startup.
TABLEX_DINER_BASE_URL=http://localhost:3000
TABLEX_ADMIN_BASE_URL=http://localhost:3001

# --- Server ---
TABLEX_PORT=8080
TABLEX_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Required in production: without it gin trusts every proxy header, which makes the client
# IP spoofable and silently defeats the rate limiter.
TABLEX_TRUSTED_PROXIES= 

# --- Database ---
# 5434 because 5432 and 5433 are commonly taken by other local stacks.
TABLEX_DB_HOST=127.0.0.1 
TABLEX_DB_PORT=5434 
TABLEX_DB_USER=postgres
TABLEX_DB_PASSWORD=postgres
TABLEX_DB_NAME=tablex
TABLEX_DB_SSLMODE=disable

# --- Auth ---
# No default exists for this on purpose: the server refuses to start without it rather
# than falling back to a value that would ship to production and forge any staff token.
# Generate one with: openssl rand -hex 32
TABLEX_JWT_SECRET=

# --- Platform (restaurant onboarding, docs/DECISIONS.md D14) ---
# Authorises POST /api/platform/v1/restaurants, which creates a restaurant, its owner login
# and its tables. Leave it EMPTY and the route group is never mounted -- onboarding then
# answers 404, which is the right default for a deployment whose tenants are created some
# other way. Set it and that endpoint exists, guarded by this one shared secret, so treat it
# like a root password: at least 32 characters (enforced in production), rotated when someone
# with it leaves, and never the same value as TABLEX_JWT_SECRET.
# Generate one with: openssl rand -hex 32
TABLEX_PLATFORM_TOKEN=

# --- Payments ---
# upi_static needs no account and no fees, and cannot confirm that money arrived --
# staff marks payment received. See docs/DECISIONS.md D2.
TABLEX_PAYMENT_PROVIDER=upi_static
# Leave the Razorpay values empty to keep the gateway disabled; the registry falls back to
# static UPI rather than failing the payment screen.
TABLEX_RAZORPAY_KEY_ID=
TABLEX_RAZORPAY_KEY_SECRET=
TABLEX_RAZORPAY_WEBHOOK_SECRET=

# --- Dish photo storage: Cloudflare R2 (docs/DECISIONS.md D15) ---
# R2, NOT AWS S3. The Go client is github.com/aws/aws-sdk-go-v2/service/s3 because R2 ships no
# SDK of its own and speaks the S3 protocol -- that package name is the protocol, not the
# vendor. These are R2 API tokens from the Cloudflare dashboard (R2 -> Manage API Tokens),
# scoped to Object Read & Write on one bucket. AWS keys will not work.
#
# LEAVE ALL FIVE EMPTY FOR ORDINARY LOCAL WORK. Uploads are then disabled, the admin panel
# hides the control, and dishes keep whatever image_url was pasted into them. Nothing else
# degrades.
#
# ALL FIVE OR NONE. A half-filled block fails startup rather than quietly disabling uploads:
# nobody fills in three of five on purpose, and silently disabling would let a deploy that was
# meant to turn uploads on report success.
# Just the account id -- the SUBDOMAIN from the bucket's "S3 API" row in the dashboard, which
# displays a whole URL: https://ACCOUNT_ID.r2.cloudflarestorage.com/BUCKET
# Paste only the hex part. Startup refuses a URL here, because a pasted one builds a mangled
# endpoint and fails as an unresolvable host, which reads as "R2 is down".
TABLEX_R2_ACCOUNT_ID=
TABLEX_R2_ACCESS_KEY_ID=
TABLEX_R2_SECRET_ACCESS_KEY=
TABLEX_R2_BUCKET=
# The public origin diners load images from -- a custom domain bound to the bucket, e.g.
# https://img.tabley.in. NOT the <account>.r2.cloudflarestorage.com endpoint, which is
# authenticated and serves nothing publicly; startup rejects that value specifically. The
# bucket's own r2.dev subdomain works for a quick local trial but Cloudflare rate limits it
# and documents it as unsuitable for production.
TABLEX_R2_PUBLIC_BASE_URL=
# Optional; both have defaults (5 MB, 5m).
# TABLEX_STORAGE_MAX_UPLOAD_BYTES=5242880
# TABLEX_STORAGE_PRESIGN_TTL=5m

# --- Frontend (Next.js needs the NEXT_PUBLIC_ prefix to expose these to the browser) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8080

# --- Public marketing page at / (apps/diner) ---
# Origin of the public site, no trailing slash. Feeds metadataBase, the canonical link,
# robots.txt and sitemap.xml -- get it wrong in production and every one of those points at
# localhost, which is invisible to a crawler rather than merely ugly.
NEXT_PUBLIC_SITE_URL=https://tabley.in
# Where the footer's "Staff sign in" goes.
NEXT_PUBLIC_ADMIN_BASE_URL=http://localhost:3001
# REQUIRED FOR ANY PRODUCTION https BUILD -- src/lib/site.ts throws without it, deliberately.
# There is no self-serve signup, so every primary CTA on the page is a mailto: to this address.
# A production build that shipped with the button pointing nowhere would be worse than a
# failed one, so the failure is moved to build time where somebody is watching.
NEXT_PUBLIC_CONTACT_EMAIL=hellotabley@gmail.com
# Optional. Slug of a restaurant onboarded AS A DEMO -- it puts a "try the real diner flow"
# section on the page. Leave EMPTY unless such a restaurant exists: pointing it at a slug that
# does not exist sends a prospect to a 404, and pointing it at a paying tenant walks strangers
# into their live menu and mints guest sessions on their tables. Unset, the section is omitted.
NEXT_PUBLIC_DEMO_RESTAURANT_SLUG=

# --- Email (Brevo) ---
TABLEX_BREVO_API_KEY=
